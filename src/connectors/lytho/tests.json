    {
      "id": "8",
      "name": "download - fullres (web intent, raster original)",
      "descr": "On the web (on-screen) intent, a PNG/JPEG asset at fullres is served as its original bytes via /assets/grafx/assets/:id/content — GraFx accepts PNG/JPEG on-screen, so no conversion. The file type is resolved first via GET /assets/assets/:id.",
      "method": "download",
      "arguments": {
        "id": "69de58c9bb8c4c6895418fa0",
        "download_type": "fullres",
        "download_intent": "web",
        "context": {}
      },
      "asserts": {
        "fetch": [
          {
            "url": "/assets/assets/69de58c9bb8c4c6895418fa0",
            "method": "GET",
            "count": 1,
            "response": {
              "status": 200,
              "headers": { "content-type": "application/json" },
              "body": { "id": "69de58c9bb8c4c6895418fa0", "name": "Raster Asset", "extension": "jpg", "fileType": "image/jpeg" }
            }
          },
          {
            "url": "/assets/grafx/assets/69de58c9bb8c4c6895418fa0/content",
            "method": "GET",
            "count": 1
          }
        ]
      }
    },
    {
      "id": "9",
      "name": "download - highres (web intent)",
      "descr": "On the web (on-screen) intent, highres routes to the rasterized twin /assets/grafx/assets/:id/hrpreview so the canvas can decode non-raster originals",
