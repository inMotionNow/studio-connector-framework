    {
      "id": "21",
      "name": "download - fullres (print intent, AI is not rerouted)",
      "descr": "An .ai file is internally %PDF and exports correctly through CHILI today, so it is deliberately absent from the denylist and keeps /assets/grafx/assets/:id/content — even though a literal reading of CHILI's animation contract would include it. If this ever routes to /pdf, that exclusion has been undone by accident.",
      "method": "download",
      "arguments": {
        "id": "6c3d4e5f60718293a4b5c6d7",
        "download_type": "fullres",
        "download_intent": "print",
        "context": {}
