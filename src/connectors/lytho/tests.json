    {
      "id": "22",
      "name": "download - fullres (print intent, uppercase EPS extension)",
      "descr": "Extensions are stored case-sensitively, so an asset ingested as .EPS reports extension 'EPS'. The denylist is matched case-insensitively, so it must still route to the PDF rendition. Guards against a regression that drops the lower-casing in _getExtension.",
      "method": "download",
      "arguments": {
        "id": "6d4e5f60718293a4b5c6d7e8",
        "download_type": "fullres",
        "download_intent": "print",
